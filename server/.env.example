# Database connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=rasibe
PGUSER=rasibe_app
PGPASSWORD=rasibe_app_pw

# API
PORT=4000
SESSION_TTL_HOURS=8
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# CSRF (NFR-SEC-008). See docs/CSRF.md.
# Signs the token that protects state-changing requests. Without it a new
# secret is generated at boot, so outstanding tokens stop working on restart
# and every instance of a multi-instance deployment disagrees. Set it to a long
# random value in anything other than local development.
#CSRF_SECRET=

# Encryption at rest (NFR-SEC-005). See docs/ENCRYPTION.md.
# Two separate 32-byte keys: one encrypts the identity, banking and vetting
# values, the other derives the fingerprint that keeps the identity number
# unique. Generate each with: openssl rand -hex 32
# Unset, a fixed development key is derived so a fresh clone and the test suite
# work with no setup. Unset with NODE_ENV=production the server refuses to
# start, because the alternative is writing the data in clear.
# Losing the first key loses the data it protects. Back it up with the database
# password, not inside the database.
#DATA_ENCRYPTION_KEY=
#DATA_INDEX_KEY=

# Password pepper. See docs/PASSWORDS.md.
# A third 32-byte key, given to Argon2id as its secret, so a copy of the
# database alone cannot be used to guess passwords. Same format and same rule
# as the keys above: a development value is derived when unset, and production
# refuses to start without it. Losing it means no password verifies, so back it
# up with the encryption key.
#PASSWORD_PEPPER=

# Breached-password check on a password change. Defaults to the Have I Been
# Pwned range API. Only the first five characters of the SHA-1 are sent. Set
# this only to point at a mirror; the test suite points it at a local stand-in.
#PWNED_PASSWORDS_URL=https://api.pwnedpasswords.com/range/

# Backups (NFR-REL-003). See docs/BACKUP.md.
# npm run backup and npm run restore connect as the database owner, because
# row-level security would give the application role a partial copy. They also
# need the three keys above, set to the API's values: their fingerprints are
# written into every manifest and checked on restore.
#BACKUP_DIR=/var/backups/rasibe
#BACKUP_RETENTION_DAYS=30
#BACKUP_PGUSER=postgres
#BACKUP_PGPASSWORD=
# Run pg_dump and pg_restore inside this container when they are not installed locally.
#PG_DOCKER_CONTAINER=

# Building a new database with `npm run db:setup` (docs/DEPLOY.md). Uses the
# BACKUP_PG* owner connection above. Required for any host but this machine;
# each replaces a password the seed would otherwise leave at its published value.
#RASIBE_APP_PASSWORD=
#RASIBE_REPORTING_PASSWORD=
#DEMO_ACCOUNT_PASSWORD=

# TLS (NFR-SEC-001). See docs/TLS.md.
# Set both to serve HTTPS from this process. Generate a development pair with
# scripts/gen-dev-cert.ps1. Leave them unset where a platform or reverse proxy
# terminates TLS in front of the API; that is also what CI does.
#TLS_CERT_FILE=
#TLS_KEY_FILE=

# Redirect plain HTTP to HTTPS. Only switch this on where HTTPS is reachable,
# or every request will be bounced to a port that is not listening.
#FORCE_HTTPS=true

# The host that redirect points at. Required whenever FORCE_HTTPS is true, and
# startup refuses without it. It cannot be read from the request: the Host
# header is supplied by the caller, so a redirect built from it lets the caller
# choose where the browser is sent. A bare host, or host:port. No scheme.
#PUBLIC_HOST=cpms.rasibe.co.za

# Number of proxy hops to trust, or a list of addresses. Set this only when a
# proxy really is in front. Without it the forwarded headers are ignored, which
# is what stops a client choosing the address written to login_attempt.
#TRUST_PROXY=1

# Encrypt the database connection: disable (default), require, or verify-full.
# A hosted database needs at least require. verify-full also checks the chain,
# and needs PGSSLROOTCERT unless the authority is already trusted.
#PGSSLMODE=require
#PGSSLROOTCERT=

# Notification delivery.
# Leave SMTP_HOST empty to queue notifications in the database only, which is
# the documented development behaviour. A delivery failure never rolls back a
# business transaction.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@rasibe.co.za
