# Database connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=rasibe
PGUSER=rasibe_app
PGPASSWORD=rasibe_app_pw

# API
PORT=4000
SESSION_TTL_HOURS=8
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Notification delivery.
# Leave SMTP_HOST empty to queue notifications in the database only, which is
# the documented development behaviour. A delivery failure never rolls back a
# business transaction.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@rasibe.co.za
